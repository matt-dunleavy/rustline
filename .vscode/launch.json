{
  "version": "0.2.0",
  "configurations": [
      {
          "type": "lldb",
          "request": "launch",
          "name": "Debug executable",
          "cargo": {
              "args": [
                  "build",
                  "--bin=${workspaceFolderBasename}",
                  "--package=${workspaceFolderBasename}"
              ],
              "filter": {
                  "name": "${workspaceFolderBasename}",
                  "kind": "bin"
              }
          },
          "args": [],
          "cwd": "${workspaceFolder}"
      },
      {
          "type": "lldb",
          "request": "launch",
          "name": "Debug unit tests",
          "cargo": {
              "args": [
                  "test",
                  "--no-run",
                  "--bin=${workspaceFolderBasename}",
                  "--package=${workspaceFolderBasename}"
              ],
              "filter": {
                  "name": "${workspaceFolderBasename}",
                  "kind": "bin"
              }
          },
          "args": [],
          "cwd": "${workspaceFolder}"
      },
      {
          "type": "lldb",
          "request": "launch",
          "name": "Debug integration tests",
          "cargo": {
              "args": [
                  "test",
                  "--no-run",
                  "--test=*"
              ]
          },
          "args": [],
          "cwd": "${workspaceFolder}"
      },
      {
          "type": "lldb",
          "request": "launch",
          "name": "Debug benchmark",
          "cargo": {
              "args": [
                  "bench",
                  "--no-run"
              ]
          },
          "args": [],
          "cwd": "${workspaceFolder}"
      }
  ]
}
