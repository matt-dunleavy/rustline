# Generated by Cargo
# will have compiled files and executables
debug/
target/
# Cargo.lock is committed, library or not: it is what makes a CI failure
# reproducible and a supply-chain change visible in review. Downstream crates
# ignore it, so committing it costs them nothing.
# https://doc.rust-lang.org/cargo/faq.html#why-do-binaries-have-cargolock-in-version-control-but-not-libraries

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# RustRover
# JetBrains specific template is maintained in a separate JetBrains.gitignore that can
# be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
# and can be added to the global gitignore or merged into this file. For a more nuclear
# option (not recommended) you can uncomment the following to ignore the entire idea folder.
.idea/

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Local History for Visual Studio Code
.history/

# Built Visual Studio Code Extensions
*.vsix

# Rust
**/*.swp
**/*.swo
**/target
**/*.orig
**/*.rej

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~
.directory

# Editor directories and files
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment variables
.env
.env.local
.env.*.local

# Logs
logs/
*.log

# Test coverage
coverage/
*.lcov
tarpaulin-report.html

# Benchmarking
/target/criterion

# Documentation
/target/doc

# Temporary files
*.tmp
*.temp

# Personal build and editor configuration. `jobs = N` and one-letter aliases
# belong in ~/.cargo/config.toml, not in a repository other people clone; a
# committed rust-toolchain.toml also makes every contributor and CI run pull
# rust-analyzer, rust-docs and rust-src.
.cargo/
.config/
rust-toolchain.toml


